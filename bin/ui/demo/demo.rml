<rml>
	<head>
		<title>Demo</title>
        <link type="text/template" href="window.rml" />
        <style>
			div#title_bar div#icon
			{
				display: none;
			}

			div#content
			{
				text-align: left;
			}
            
            #configurations 
            {
                bottom: 50dp; left: 50dp; position: absolute; width: 200dp; height: 200dp;
            }
            
            #orders {
                 top: 50dp; left: 50dp; position: absolute; width: 200dp; height: 200dp;
            }
		</style>
	</head>
	<body style="height: 100%; width: 100%;">

        <!-- Configurations -->
        <div id="configurations" class="card" data-model="configurations">
            <template src="window">
                <div class="card-header">Configurations - {{configuration_name}}</div>
                <div class="card-body placeholder">
                    <button type="button" class="button" onclick="configuration:{{i}}" data-for="i : configurations">{{i}}</button>
                </div>
            </template>
        </div>

        <!-- Orders -->
        <div id="orders" class="card" data-model="orders">
            <template src="window">
                <div class="card-header">Orders - {{order_name}}</div>
                <div class="card-body placeholder">
                    <button type="button" class="button" onclick="order:{{i}}" data-for="i : orders">{{i}}</button>
                </div>
            </template>
        </div>

    </body>
</rml>
