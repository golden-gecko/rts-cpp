<rml>
    <head>
        <link type="text/rcss" href="styles/ui.rcss"/>
    </head>

    <body>
        <!-- Configurations -->
        <div id="configurations" class="card" data-model="configurations">
            <div class="card-header">Configurations - {{configuration_name}}</div>

            <div class="card-body placeholder">
                <button type="button" class="button" onclick="configuration:{{i}}" data-for="i : configurations">{{i}}</button>
            </div>
        </div>

        <!-- Diplomacy -->
        <div id="diplomacy" class="background hidden" data-model="diplomacy">
            <div class="card modal">
                <div class="card-header">Diplomacy</div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td>Name</td>
                                <td>Color</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : diplomacy">
                                <td class="number">{{i.id}}</td>
                                <td>{{i.name}}</td>
                                <td>{{i.color}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:diplomacy">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Game Menu -->
        <div id="game-menu" class="card">
            <div class="card-body">
                <button class="button" onclick="open:diplomacy">Diplomacy</button>
                <button class="button" onclick="open:layers">Layers</button>
                <button class="button" onclick="menu:main-menu">Menu</button>
                <button class="button" onclick="open:objects-admin">Objects</button>
                <button class="button" onclick="open:orders-admin">Orders</button>
                <button class="button" onclick="open:statistics">Statistics</button>
                <button class="button" onclick="open:technologies">Technologies</button>
            </div>
        </div>

        <!-- Info -->
        <div id="info" class="card" data-model="info">
            <div class="card-header">Info</div>

            <div class="card-body">
                <pre>{{info}}</pre>
            </div>
        </div>

        <!-- Layers -->
        <div id="layers" class="card hidden">
            <div class="card-header">Layers</div>

            <div class="card-body">
                <div class="container body">
                    <div>
                        <div class="row">
                            <div class="col-4">
                                Air
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="None" id="Air_None" name="Air" checked="checked" />
                                    <label class="form-check-label" for="Air_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="Pollution" id="Air_Pollution" name="Air" />
                                    <label class="form-check-label" for="Air_Pollution">Pollution</label>
                                </div>
                            </div>
                            <div class="col-4">
                                Terrain
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="None" id="Terrain_None" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Height" id="Terrain_Height" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_Height">Height</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Navigation" id="Terrain_Navigation" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_Navigation">Navigation</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Type" id="Terrain_Type" name="Terrain" checked="checked" />
                                    <label class="form-check-label" for="Terrain_Type">Type</label>
                                </div>
                            </div>
                            <div class="col-4">
                                Water
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="None" id="Water_None" name="Water" />
                                    <label class="form-check-label" for="Water_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Height" id="Water_Height" name="Water" checked="checked" />
                                    <label class="form-check-label" for="Water_Height">Height</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Pollution" id="Water_Pollution" name="Water" />
                                    <label class="form-check-label" for="Water_Pollution">Pollution</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Type" id="Water_Type" name="Water" />
                                    <label class="form-check-label" for="Water_Type">Type</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="buttons">
                        <button class="button">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Load Menu -->
        <div id="load-menu" class="card centered hidden" data-model="load_menu">
            <div class="card-header">Load</div>
            <div class="card-body">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" data-for="i : saves">{{i}}</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </div>
        </div>

        <!-- Log -->
        <div id="log" class="card" data-model="log">
            <div class="card-body placeholder">
                <p class="{{i.level}}" data-for="i : log">{{i.message}}</p>
            </div>
        </div>

        <!-- Main Menu -->
        <div id="main-menu" class="card centered hidden">
            <div class="card-header">Menu</div>
            <div class="card-body">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" onclick="menu:map-menu">New game</button>
                <button class="button">Save</button>
                <button class="button" onclick="menu:load-menu">Load</button>
                <button class="button">Options</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </div>
        </div>

        <!-- Map Menu -->
        <div id="map-menu" class="card centered hidden" data-model="map_menu">
            <div class="card-header">Maps</div>
            <div class="card-body">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" data-for="i : maps">{{i}}</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </div>
        </div>

        <!-- Minimap-->
        <div id="minimap" class="card">
            <div class="card-header">Minimap</div>

            <div class="card-body">
                <img src="texture_minimap" />
            </div>
        </div>

        <!-- Objects (admin) -->
        <div id="objects-admin" class="background hidden" data-model="objects_admin">
            <div class="card modal">
                <div class="card-header">Objects</div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td>Name</td>
                                <td class="number">Order count</td>
                                <td>Current order</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : objects_admin">
                                <td class="number">{{i.id}}</td>
                                <td>{{i.name}}</td>
                                <td class="number">{{i.order_count}}</td>
                                <td>{{i.order_name}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:objects-admin">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Options -->
        <div id="options" class="card hidden">
            <div class="card-header">Options</div>
            <div class="card-body">
                <form>
                    <div class="form-group row">
                        <label for="input_mouse_sensivity_x" class="col-sm-4 col-form-label">Mouse sensivity X</label>
                        <div class="col-sm-8">
                            <input type="email" class="form-control" id="input_mouse_sensivity_x" name="input_mouse_sensivity_x" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="input_mouse_sensivity_y" class="col-sm-4 col-form-label">Mouse sensivity Y</label>
                        <div class="col-sm-8">
                            <input type="email" class="form-control" id="input_mouse_sensivity_y" name="input_mouse_sensivity_y" />
                        </div>
                    </div>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Fog of war type</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_fuzzy" value="fuzzy" />
                                    <label class="form-check-label" for="fog_of_war_type_fuzzy">fuzzy</label>
                                </div>

                                <div class="form-check disabled">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_solid" value="solid" />
                                    <label class="form-check-label" for="fog_of_war_type_solid">solid</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_none" value="none" />
                                    <label class="form-check-label" for="fog_of_war_type_none">none</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Minimap</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_visible" value="visible" />
                                    <label class="form-check-label" for="ui_minimap_visible">visible</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_hidden" value="hidden" />
                                    <label class="form-check-label" for="ui_minimap_hidden">hidden</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Preview</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_visible" value="visible" />
                                    <label class="form-check-label" for="ui_preview_visible">visible</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_hidden" value="hidden" />
                                    <label class="form-check-label" for="ui_preview_hidden">hidden</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <div class="col-sm-12 buttons">
                        <button type="submit" class="button">Save</button>
                        <button class="button">Close</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Orders -->
        <div id="orders" class="card" data-model="orders">
            <div class="card-header">Orders - {{order_name}}</div>

            <div class="card-body placeholder">
                <button type="button" class="button" onclick="order:{{i}}" data-for="i : orders">{{i}}</button>
            </div>
        </div>

        <!-- Orders (admin) -->
        <div id="orders-admin" class="background hidden" data-model="orders_admin">
            <div class="card modal">
                <div class="card-header">Orders</div>

                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td class="number">Sender</td>
                                <td class="number">Receiver</td>
                                <td>Type</td>
                                <td>Attempts</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : orders_admin">
                                <td class="number">{{i.id}}</td>
                                <td>{{i.name}}</td>
                                <td class="number">{{i.sender_name}}</td>
                                <td class="number">{{i.receiver_name}}</td>
                                <td>{{i.attempts}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:orders-admin">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Players -->
        <div id="players" class="card" data-model="players">
            <div class="card-header">Players</div>

            <div class="card-body">
                <table>
                    <tbody>
                        <tr data-for="i : players">
                            <td class="number">{{i.id}}</td>
                            <td>{{i.name}}</td>
                            <td>{{i.color}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Preview -->
        <div id="preview" class="card">
            <div class="card-header">Preview</div>

            <div class="card-body">
                <img src="texture_preview" />
            </div>
        </div>

        <!-- Resources -->
        <div id="resources" class="card" data-model="resources">
            <div class="card-header">Resources</div>

            <div class="card-body">
                <table>
                    <tbody>
                        <tr data-for="i : resources">
                            <td>{{i.name}}</td>
                            <td class="number">{{format(i.current, 1)}}</td>
                            <td class="number">{{format(i.max, 1)}}</td>
                            <td class="number {{i.direction}}">{{format(i.ratio, 1)}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Skills -->
        <div id="skills" class="card" data-model="skills">
            <div class="card-header">Skills - {{skill_name}}</div>

            <div class="card-body">
                <button type="button" class="button" onclick="skill:{{i}}" data-for="i : skills">{{i}}</button>
            </div>
        </div>

        <!-- Statistics -->
        <div id="statistics" class="background hidden" data-model="statistics">
            <div class="card modal">
                <div class="card-header">Statistics</div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <td>Name</td>
                                <td class="number">Value</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : statistics">
                                <td class="name">{{i.name}}</td>
                                <td class="value number">{{i.value}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:statistics">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Technologies -->
        <div id="technologies" class="background hidden" data-model="technologies">
            <div class="card modal">
                <div class="card-header">Technologies</div>
                <div class="card-body">
                    <div data-for="i : technologies">
                        <button type="button" class="button">{{i}}</button>
                    </div>

                    <div class="buttons">
                        <button class="button" onclick="close:technologies">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!--
        <div id="floating_descriptions">
            <div class="floating-description hidden" id="object_0" style="left: 350px; top: 400px;">
                <div class="name">Tank</div>
                <div class="bar health"><div class="bar-background"><div class="bar-current" style="width: 90%;"></div></div></div>
                <div class="bar fuel"><div class="bar-background"><div class="bar-current" style="width: 20%;"></div></div></div>
                <div class="bar ammunition"><div class="bar-background"><div class="bar-current" style="width: 25%;"></div></div></div>
                <div class="bar reload"><div class="bar-background"><div class="bar-current" style="width: 30%;"></div></div></div>
            </div>
        </div>
        -->
    </body>
</rml>
