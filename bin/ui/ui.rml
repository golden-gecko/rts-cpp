<rml>
	<head>
        <link type="text/template" href="window.rml" />
    </head>
	<body style="height: 100%; width: 100%;">

        <!-- Configurations -->
        <div id="configurations" class="panel" data-model="configurations">
            <template src="window">
                <div class="panel-header">Configurations - {{selected_configuration}}</div>
                <div>
                    <button type="button" class="button" onclick="configuration:{{i.name}}" data-for="i : configurations">{{i.name}}</button>
                </div>
            </template>
        </div>

        <!-- Console -->
        <div id="console" class="ackground hidden popup panel" data-model="console">
            <template src="window">
                <p data-for="i : commands">{{i.timestamp}} {{i.command}}</p>
                <input id="console-input" class="text" type="text" />
            </template>
        </div>

        <!-- Diplomacy -->
        <div id="diplomacy" class="background hidden popup panel" data-model="diplomacy">
            <template src="window">
                <div>
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td class="text">Name</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : players">
                                <td class="number">{{i.id}}</td>
                                <td class="text">{{i.name}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:diplomacy">Close</button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Game Menu -->
        <div id="game-menu" class="panel">
            <template src="window">
                <button class="button" onclick="open:diplomacy">Diplomacy</button>
                <button class="button" onclick="open:layers">Layers</button>
                <button class="button" onclick="menu:main-menu">Menu</button>
                <button class="button" onclick="open:objects-admin">Objects</button>
                <button class="button" onclick="open:orders-admin">Orders</button>
                <button class="button" onclick="open:statistics">Statistics</button>
                <button class="button" onclick="open:technologies">Technologies</button>
            </template>
        </div>

        <!-- Info -->
        <div id="info" class="panel" data-model="info">
            <template src="window">
                <pre>{{description.text}}</pre>
            </template>
        </div>

        <!-- Load Menu -->
        <div id="load-menu" class="hidden menu panel" data-model="load_menu">
            <template src="window">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" data-for="i : saves">{{i}}</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </template>
        </div>

        <!-- Log -->
        <div id="log" class="panel" data-model="log">
            <template src="window">
                <p class="{{i.level}}" data-for="i : log">{{i.message}}</p>
            </template>
        </div>

        <!-- Main Menu -->
        <div id="main-menu" class="hidden menu panel">
            <template src="window">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" onclick="menu:map-menu">New game</button>
                <button class="button">Save</button>
                <button class="button" onclick="menu:load-menu">Load</button>
                <button class="button">Options</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </template>
        </div>

        <!-- Map Menu -->
        <div id="map-menu" class="hidden menu panel" data-model="map_menu">
            <template src="window">
                <button class="button" onclick="menu:none">Continue</button>
                <button class="button" data-for="i : maps">{{i}}</button>
                <button class="button" onclick="call:quit-to-menu">Quit to menu</button>
                <button class="button" onclick="call:quit-to-desktop">Quit to desktop</button>
            </template>
        </div>

        <!-- Minimap-->
        <div id="minimap" class="panel">
            <template src="window">
                <img src="texture_minimap" />
            </template>
        </div>

        <!-- Objects (admin) -->
        <div id="objects-admin" class="background hidden popup panel" data-model="objects_admin">
            <template src="window">
                <div>
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td class="text">Name</td>
                                <td class="number">Order count</td>
                                <td class="text">Current order</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : objects_admin">
                                <td class="number">{{i.id}}</td>
                                <td class="text">{{i.name}}</td>
                                <td class="number">{{i.order_count}}</td>
                                <td class="text">{{i.order_name}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:objects-admin">Close</button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Orders -->
        <div id="orders" class="panel" data-model="orders">
            <template src="window">
                <div class="panel-header">Orders - {{selected_order}}</div>
                <div>
                    <button type="button" class="button" onclick="order:{{i.name}}" data-for="i : orders">{{i.name}}</button>
                </div>
            </template>
        </div>

        <!-- Orders (admin) -->
        <div id="orders-admin" class="background hidden popup panel" data-model="orders_admin">
            <template src="window">
                <div>
                    <table>
                        <thead>
                            <tr>
                                <td class="number">ID</td>
                                <td class="number">Sender</td>
                                <td class="number">Receiver</td>
                                <td class="text">Type</td>
                                <td class="text">Attempts</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-for="i : orders_admin">
                                <td class="number">{{i.id}}</td>
                                <td class="text">{{i.name}}</td>
                                <td class="number">{{i.sender_name}}</td>
                                <td class="number">{{i.receiver_name}}</td>
                                <td class="text">{{i.attempts}}</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="buttons">
                        <button class="button" onclick="close:orders-admin">Close</button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Players -->
        <div id="players" class="panel" data-model="players">
            <template src="window">
                <table>
                    <tbody>
                        <tr data-for="i : players">
                            <td class="number">{{i.id}}</td>
                            <td class="text">{{i.name}}</td>
                            <td class="text">{{i.color}}</td>
                        </tr>
                    </tbody>
                </table>
            </template>
        </div>

        <!-- Preview -->
        <div id="preview" class="panel">
            <template src="window">
                <img src="texture_preview" />
            </template>
        </div>

        <!-- Resources -->
        <div id="resources" class="panel" data-model="resources">
            <template src="window">
                <table>
                    <thead>
                        <tr>
                            <td class="text">Name</td>
                            <td class="number">Current</td>
                            <td class="number">Max</td>
                            <td class="number">Ratio</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-for="i : resources">
                            <td class="text">{{i.name}}</td>
                            <td class="number">{{format(i.current, 1)}}</td>
                            <td class="number">{{format(i.max, 1)}}</td>
                            <td class="number {{i.direction}}">{{format(i.ratio, 1)}}</td>
                        </tr>
                    </tbody>
                </table>
            </template>
        </div>

        <!-- Skills -->
        <div id="skills" class="panel" data-model="skills">
            <template src="window">
                <div class="panel-header">Skills - {{selected_skill}}</div>
                <div>
                    <button type="button" class="button" onclick="skill:{{i.name}}" data-for="i : skills">{{i.name}}</button>
                </div>
            </template>
        </div>

        <!-- Statistics -->
        <div id="statistics" class="background hidden popup panel" data-model="statistics">
            <template src="window">
                <table>
                    <thead>
                        <tr>
                            <td class="text">Name</td>
                            <td class="number">Value</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-for="i : items">
                            <td class="name">{{i.name}}</td>
                            <td class="value number">{{i.value}}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="buttons">
                    <button class="button" onclick="close:statistics">Close</button>
                </div>
            </template>
        </div>

        <!-- Technologies -->
        <div id="technologies" class="background hidden panel" data-model="technologies">
            <template src="window">
                <div>
                    <div data-for="i : technologies">
                        <button type="button" class="button">{{i}}</button>
                    </div>

                    <div class="buttons">
                        <button class="button" onclick="close:technologies">Close</button>
                    </div>
                </div>
            </template>
        </div>

    </body>
</rml>
