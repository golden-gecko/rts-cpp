<rml>
<head>
    <title>UI</title>

    <style>
        /* Global */

        body,
        html {
            color: #212529;
            font-family: LatoLatin;
            font-size: 1.2rem;
            height: 100%;
            width: 100%;
        }

        pre {
            white-space: pre;
        }

        table {
	        box-sizing: border-box;
	        display: table;
        }

        tbody,
        tfoot,
        thead {
	        display: table-row-group;
        }

        td {
	        box-sizing: border-box;
	        display: table-cell;
            padding: 0.1rem 0.5rem 0.1rem 0.5rem;
        }
        
        tr {
	        box-sizing: border-box;
	        display: table-row;
        }

        .background {
            background-color: rgba(255, 255, 255, 192);
            bottom: 0px;
            border-radius: .5rem;
            display: block;
            left: 0px;
            position: absolute;
            right: 0px;
            top: 0px;
            z-index: 10;
        }

        .button {
            background-color: #e9ecef;
            border-color: #e9ecef;
            border-radius: .25rem;
            color: #212529;
            display: inline-block;
            margin-left: 2px;
            padding: 5px 10px;
            text-align: center;
            vertical-align: middle;
        }

        .button:active,
        .button:hover {
            color: #000;
            background-color: #f9fafb;
            border-color: #f9fafb;
        }

        .buttons {
            bottom: 10px;
            position: absolute;
        }

        .card {
            display: flex;
            flex-direction: column;
            background-color: #fff;
            border-radius: .5rem;
            position: absolute;
        }

        .card-header {
            background-color: #eee;
            border-radius: .5rem .5rem 0 0;
            padding: 10px 15px;
        }

        .card-header .button-collapse,
        .card-header .button-expand {
            float: right;
            height: 16px;
            margin: 2px -2px 0 8px;
            width: 16px;
        }

        .card-header .button-expand {
            display: none;
        }

        .card-body {
            padding: 15px;
        }

        .centered {
            left: 50%;
            position: fixed;
            top: 50%;
        }

        .hidden {
            display: none;
        }

        .modal {
            bottom: 200px;
            left: 200px;
            position: absolute;
            right: 200px;
            top: 200px;
        }

        /* Configurations */

        #configurations {
            bottom: 265px;
            left: 550px;
        }

        /* Cursor */

        #cursor {
            position: absolute;
        }

        #cursor img {
            width: 30px;
        }

        #cursor .attack {
            margin-left: -15px;
            margin-top: -15px;
        }

        #cursor .idle {
            display: block;
            margin-left: -8px;
            margin-top: -3px;
        }

        #cursor .move {
            margin-left: -16px;
            margin-top: -15px;
        }

        /* Floating description */

        .floating-description {
            background-color: #fff;
            display: block;
            min-width: 100px;
            position: absolute;
        }

        .floating-description .bar {
            display: block;
            width: 100%;
        }

        .floating-description .bar .bar-background {
            background: #0ff;
            width: 100%;
        }

        .floating-description .bar .bar-background,
        .floating-description .bar .bar-current {
            display: block;
            height: 5px;
        }

        .floating-description .bar .bar-current {
        }

        .floating-description .bar.ammunition .bar-background {
            background: #800;
        }

        .floating-description .bar.ammunition .bar-current {
            background: #f00;
        }

        .floating-description .bar.fuel .bar-background {
            background: #840;
        }

        .floating-description .bar.fuel .bar-current {
            background: #f80;
        }

        .floating-description .bar.health .bar-background {
            background: #040;
        }

        .floating-description .bar.health .bar-current {
            background: #080;
        }

        .floating-description .bar.reload .bar-background {
            background: #008;
        }

        .floating-description .bar.reload .bar-current {
            background: #00f;
        }

        .floating-description .name {
            display: block;
            padding: 5px;
        }

        /* Game Menu */

        #game-menu {
            right: 5px;
            top: 5px;
        }

        /* Info */

        #info {
            bottom: 5px;
            left: 310px;
        }

        /* Log */

        #log {
            left: 5px;
            right: 50%;
            top: 5px;
        }

        #log p {
            display: block;
        }

        #log .error {
            color: red;
        }

        #log .info {
            color: green;
        }

        /* Menu */

        #load-menu button,
        #main-menu button,
        #map-menu button {
            display: block;
            height: 30px;
            margin-bottom: 0.4rem;
            width: 300px;
        }

        #load-menu .button-quit-application,
        #main-menu .button-quit-application,
        #map-menu .button-quit-application {
            margin-bottom: 0;
        }

        /* Minimap */

        #minimap {
            bottom: 5px;
            right: 5px;
        }

        /* Orders */

        #orders {
            bottom: 150px;
            left: 550px;
        }

        /* Players */

        #players {
            left: 700px;
            top: 60px;
        }

        /* Preview */

        #preview {
            bottom: 5px;
            left: 5px;
        }

        #preview .body {
            height: 128px;
            width: 128px;
        }

        /* Resources */

        #resources {
            display: flex;
            left: 5px;
            top: 100px;
            width: 300px;
        }

        #resources td {
            min-width: 50px;
        }

        #resources .green {
            color: green;
        }

        #resources .red {
            color: red;
        }

        /* Skills */

        #skills {
            bottom: 5px;
            left: 550px;
        }

        /* Technologies */

        #technologies .placeholder .button {
            margin: 5px;
        }
    </style>
</head>

<body>
    <!-- Configurations -->
    <div id="configurations" class="card">
        <div class="card-header">Configurations - <span class="card-header-placeholder">None</span>
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body placeholder"></div>
    </div>

    <!-- Diplomacy -->
    <div id="diplomacy" class="background hidden">
        <div class="card modal">
            <div class="card-header">Diplomacy</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr></tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button" onclick="close:diplomacy">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Game Menu -->
    <div id="game-menu" class="card">
        <div class="card-body">
            <button class="button button-diplomacy" onclick="open:diplomacy">Diplomacy</button>
            <button class="button button-layers" onclick="open:layers">Layers</button>
            <button class="button button-main-menu" onclick="open:main-menu">Menu</button>
            <button class="button button-objects" onclick="open:objects-admin">Objects</button>   
            <button class="button button-orders" onclick="open:orders-admin">Orders</button>
            <button class="button button-statistics" onclick="open:statistics">Statistics</button>
            <button class="button button-technologies" onclick="open:technologies">Technologies</button>
        </div>
    </div>

    <!-- Info -->
    <div id="info" class="card">
        <div class="card-header">Info
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body">
            <pre class="placeholder"></pre>
        </div>
    </div>

    <!-- Layers -->
    <div id="layers" class="card hidden">
        <div class="card-header">Layers</div>

        <div class="card-body">
            <div class="container body">
                <div class="placeholder">
                    <div class="row">
                        <div class="col-4">Air
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="None" id="Air_None" name="Air" checked="checked" />
                                <label class="form-check-label" for="Air_None">None</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="Pollution" id="Air_Pollution" name="Air" />
                                <label class="form-check-label" for="Air_Pollution">Pollution</label>
                            </div>
                        </div>
                        <div class="col-4">Terrain
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="None" id="Terrain_None" name="Terrain" />
                                <label class="form-check-label" for="Terrain_None">None</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Height" id="Terrain_Height" name="Terrain" />
                                <label class="form-check-label" for="Terrain_Height">Height</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Navigation" id="Terrain_Navigation" name="Terrain" />
                                <label class="form-check-label" for="Terrain_Navigation">Navigation</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Type" id="Terrain_Type" name="Terrain" checked="checked" />
                                <label class="form-check-label" for="Terrain_Type">Type</label>
                            </div>
                        </div>
                        <div class="col-4">Water
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="None" id="Water_None" name="Water" />
                                <label class="form-check-label" for="Water_None">None</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Height" id="Water_Height" name="Water" checked="checked" />
                                <label class="form-check-label" for="Water_Height">Height</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Pollution" id="Water_Pollution" name="Water" />
                                <label class="form-check-label" for="Water_Pollution">Pollution</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Type" id="Water_Type" name="Water" />
                                <label class="form-check-label" for="Water_Type">Type</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="buttons">
                    <button class="button">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Load Menu -->
    <div id="load-menu" class="card hidden centered">
        <div class="card-header">Load</div>
        <div class="card-body">
            <button class="button-continue button">Continue</button>
            <div class="placeholder">
                <button class="button" data-name="2017_10_12_12_51_41">2017_10_12_12_51_41</button>
                <button class="button" data-name="2018_10_12_12_51_41">2018_10_12_12_51_41</button>
                <button class="button" data-name="2019_10_12_12_51_41">2019_10_12_12_51_41</button>
                <button class="button" data-name="2020_10_03_12_51_19">2020_10_03_12_51_19</button>
                <button class="button" data-name="2020_11_10_13_21_33">2020_11_10_13_21_33</button>
            </div>
            <button class="button-quit-game button">Quit to menu</button>
            <button class="button-quit-application button">Quit to desktop</button>
        </div>
    </div>

    <!-- Log -->
    <div id="log" class="card">
        <div class="card-body placeholder"></div>
    </div>

    <!-- Main Menu -->
    <div id="main-menu" class="card hidden centered">
        <div class="card-header">Menu</div>
        <div class="card-body">
            <button class="button button-continue">Continue</button>
            <button class="button button-new-game">New game</button>
            <button class="button button-save" onclick="open:save">Save</button>
            <button class="button button-load" onclick="open:load">Load</button>
            <button class="button button-options" onclick="open:options">Options</button>
            <button class="button button-quit-game" onclick="call:quit-to-menu">Quit to menu</button>
            <button class="button button-quit-application" onclick="call:quit-to-desktop">Quit to desktop</button>
        </div>
    </div>

    <!-- Map Menu -->
    <div id="map-menu" class="card hidden centered">
        <div class="card-header">Maps</div>
        <div class="card-body">
            <button class="button-continue button">Continue</button>
            <div class="placeholder">
                <button class="button" data-name="tutorial #1">tutorial #1</button>
                <button class="button" data-name="tutorial #2">tutorial #2</button>
                <button class="button" data-name="level #1">level #1</button>
                <button class="button" data-name="level #2">level #2</button>
                <button class="button" data-name="level #3">level #3</button>
            </div>
            <button class="button-quit-game button">Quit to menu</button>
            <button class="button-quit-application button">Quit to desktop</button>
        </div>
    </div>

    <!-- Minimap-->
    <div id="minimap" class="card">
        <div class="card-header">Minimap
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body">
            <img src="texture_minimap" />
        </div>
    </div>

    <!-- Objects (admin) -->
    <div id="objects-admin" class="background hidden">
        <div class="card modal">
            <div class="card-header">Objects</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <td class="number">ID</td>
                            <td>Name</td>
                            <td class="number">Order count</td>
                            <td>Current order</td>
                        </tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button" onclick="close:objects-admin">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Options -->
    <div id="options" class="card hidden">
        <div class="card-header">Options</div>
        <div class="card-body">
            <form>
                <div class="form-group row">
                    <label for="input_mouse_sensivity_x" class="col-sm-4 col-form-label">Mouse sensivity X</label>
                    <div class="col-sm-8">
                        <input type="email" class="form-control" id="input_mouse_sensivity_x" name="input_mouse_sensivity_x" />
                    </div>
                </div>

                <div class="form-group row">
                    <label for="input_mouse_sensivity_y" class="col-sm-4 col-form-label">Mouse sensivity Y</label>
                    <div class="col-sm-8">
                        <input type="email" class="form-control" id="input_mouse_sensivity_y" name="input_mouse_sensivity_y" />
                    </div>
                </div>

                <fieldset class="form-group">
                    <div class="row">
                        <legend class="col-form-label col-sm-4 pt-0">Fog of war type</legend>
                        <div class="col-sm-8">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_fuzzy" value="fuzzy" />
                                <label class="form-check-label" for="fog_of_war_type_fuzzy">fuzzy</label>
                            </div>

                            <div class="form-check disabled">
                                <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_solid" value="solid" />
                                <label class="form-check-label" for="fog_of_war_type_solid">solid</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_none" value="none" />
                                <label class="form-check-label" for="fog_of_war_type_none">none</label>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-group">
                    <div class="row">
                        <legend class="col-form-label col-sm-4 pt-0">Minimap</legend>
                        <div class="col-sm-8">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_visible" value="visible" />
                                <label class="form-check-label" for="ui_minimap_visible">visible</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_hidden" value="hidden" />
                                <label class="form-check-label" for="ui_minimap_hidden">hidden</label>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-group">
                    <div class="row">
                        <legend class="col-form-label col-sm-4 pt-0">Preview</legend>
                        <div class="col-sm-8">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_visible" value="visible" />
                                <label class="form-check-label" for="ui_preview_visible">visible</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_hidden" value="hidden" />
                                <label class="form-check-label" for="ui_preview_hidden">hidden</label>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <div class="col-sm-12 buttons">
                    <button type="submit" class="button">Save</button>
                    <button class="button">Close</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders -->
    <div id="orders" class="card">
        <div class="card-header">Orders - <span class="card-header-placeholder">None</span>
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body placeholder"></div>
    </div>

    <!-- Orders (admin) -->
    <div id="orders-admin" class="background hidden">
        <div class="card modal">
            <div class="card-header">Orders</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <td class="number">ID</td>
                            <td class="number">Sender</td>
                            <td class="number">Receiver</td>
                            <td>Type</td>
                            <td>Attempts</td>
                        </tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button" onclick="close:orders-admin">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Players -->
    <div id="players" class="card hidden">
        <div class="card-header">Players
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body">
            <table class="table table-condensed no-header">
                <tbody class="placeholder">
                    <tr data-id="1"><td class="id number">1</td><td class="color">green</td><td class="name">CPU 1</td></tr>
                    <tr data-id="2"><td class="id number">2</td><td class="color">yellow</td><td class="name">CPU 2</td></tr>
                    <tr data-id="3"><td class="id number">3</td><td class="color">red</td><td class="name">Human</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Preview -->
    <div id="preview" class="card">
        <div class="card-header">Preview
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body">
            <img src="texture_preview" />
        </div>
    </div>

    <!-- Resources -->
    <div id="resources" class="card">
        <div class="card-header">Resources
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body">
            <table class="table table-condensed no-header">
                <tbody class="placeholder"></tbody>
            </table>
        </div>
    </div>

    <!-- Skills -->
    <div id="skills" class="card">
        <div class="card-header">Skills - <span class="card-header-placeholder">None</span>
            <img class="button-collapse" src="icons/arrow-up-short.png" />
            <img class="button-expand" src="icons/arrow-down-short.png" />
        </div>

        <div class="card-body placeholder"></div>
    </div>

    <!-- Statistics -->
    <div id="statistics" class="background hidden">
        <div class="card modal">
            <div class="card-header">Statistics</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <td>Name</td>
                            <td class="number">Value</td>
                        </tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button" onclick="close:statistics">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Technologies -->
    <div id="technologies" class="background hidden">
        <div class="card modal">
            <div class="card-header">Technologies</div>
            <div class="card-body">
                <div class="placeholder"></div>
                <div class="buttons">
                    <button class="button" onclick="close:technologies">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="floating-description hidden" id="object_0" style="left: 350px; top: 400px;">
        <div class="name">Tank</div>
        <div class="bar health"><div class="bar-background"><div class="bar-current" style="width: 90%;"></div></div></div>
        <div class="bar fuel"><div class="bar-background"><div class="bar-current" style="width: 20%;"></div></div></div>
        <div class="bar ammunition"><div class="bar-background"><div class="bar-current" style="width: 25%;"></div></div></div>
        <div class="bar reload"><div class="bar-background"><div class="bar-current" style="width: 30%;"></div></div></div>
    </div>
</body>
</rml>
