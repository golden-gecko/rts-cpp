<rml>
<head>
    <title>UI</title>

    <style>
        /* Global */

        body,
        html {
            color: #212529;
            font-family: LatoLatin;
            font-size: 1.2rem;
            height: 100%;
            width: 100%;
        }

        pre {
            white-space: pre;
        }

        table {
	        box-sizing: border-box;
	        display: table;
        }

        tbody,
        tfoot,
        thead {
	        display: table-row-group;
        }

        td {
	        box-sizing: border-box;
	        display: table-cell;
            padding: 0.1rem 0.5rem 0.1rem 0.5rem;
        }
        
        tr {
	        box-sizing: border-box;
	        display: table-row;
        }

        .button {
            display: inline-block;
            font-weight: 400;
            color: #212529;
            text-align: center;
            text-decoration: none;
            vertical-align: middle;
            cursor: pointer;
            background-color: transparent;
            border-top-color: transparent;
            border-right-color: transparent;
            border-bottom-color: transparent;
            border-left-color: transparent;
            font-size: 1rem;
            border-radius: .25rem;
            line-height: 1;
            padding: 0.4rem;
            margin-left: 0.2rem;
            background-color: #e9ecef;
            border-color: #e9ecef;
        }

        .button:active,
        .button:hover {
            color: #000;
            background-color: #f9fafb;
            border-color: #f9fafb;
        }

        .buttons {
            text-align: center;
            bottom: 10px;
            position: absolute;
            left: 50%;
            transform: translate(-50%, 0%)
        }

        .centered {
            left: 50%;
            position: fixed;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        .centered-horizontally {
            left: 50%;
            position: fixed;
            transform: translate(-50%, 0%);
        }

        .card {
            display: flex;
            flex-direction: column;
            min-width: 0;
            background-color: #fff;
            border-radius: .5rem;
            position: absolute;
        }

        .card-header {
            padding: .5rem 1rem;
            margin-bottom: 0;
            background-color: #eee;
            border-radius: .5rem .5rem 0 0;
        }

        .card-header .button-collapse,
        .card-header .button-expand {
            float: right;
            height: 16px;
            margin: 2px -2px 0 8px;
            width: 16px;
        }

        .card-header .button-expand {
            display: none;
        }

        .card-body {
            flex: 1 1 auto;
            padding: 1rem 1rem;
        }

        /* Configurations */

        #configurations {
            bottom: 100px;
            left: 220px;
        }

        /* Container */

        #container {
            bottom: 10px;
            left: 10px;
            position: absolute;
            right: 10px;
            top: 10px;
        }

        /* Cursor */

        #cursor {
            display: none;
            position: absolute;
        }

        #cursor img {
            display: none;
            width: 30px;
        }

        #cursor,
        #cursor img {
            pointer-events: none;
        }

        #cursor .attack {
            margin-left: -15px;
            margin-top: -15px;
        }

        #cursor .idle {
            display: block;
            margin-left: -8px;
            margin-top: -3px;
        }

        #cursor .move {
            margin-left: -16px;
            margin-top: -15px;
        }

        /* Diplomacy */
        #diplomacy {
            display: none;
        }
        
        #diplomacy .name {
            font-weight: bold;
        }

        /* Floating description */

        .floating-description {
            background: rgba(255, 255, 255, 0.8);
            min-width: 50px;
            position: fixed;
            z-index: -1;
        }

        .floating-description .bar {
            margin-bottom: 2px;
        }

        .floating-description .bar .background,
        .floating-description .bar .current {
            height: 3px;
        }

        .floating-description .bar .current {
            margin-top: -3px;
        }

        .floating-description .bar.ammunition .background {
            background: rgba(255, 0, 0, 0.5);
        }

        .floating-description .bar.ammunition .current {
            background: rgba(255, 0, 0, 1.0);
        }

        .floating-description .bar.fuel .background {
            background: rgba(255, 165, 0, 0.5);
        }

        .floating-description .bar.fuel .current {
            background: rgba(255, 165, 0, 1.0)
        }

        .floating-description .bar.health .background {
            background: rgba(0, 128, 0, 0.5);
        }

        .floating-description .bar.health .current {
            background: rgba(0, 128, 0, 1.0);
        }

        .floating-description .bar.reload .background {
            background: rgba(0, 0, 255, 0.5);
        }

        .floating-description .bar.reload .current {
            background: rgba(0, 0, 255, 1.0);
        }

        .floating-description .name {
            margin-bottom: 2px;
            padding: 0 4px;
        }

        /* Game Menu */

        #game-menu {
            right: 5px;
            top: 5px;
        }

        /* Info */

        #info {
            bottom: 5px;
            left: 5px;
        }

        /* Layers */

        #layers  {
            display: none;
        }

        #layers .button {
            margin-bottom: 4px;
        }
        
        /* Log */

        #log {
            left: 5px;
            right: 50%;
            top: 5px;
        }

        #log p {
            display: block;
        }

        #log .error {
            color: red;
        }

        #log .info {
            color: green;
        }

        /* Menu */

        #load-menu,
        #main-menu,
        #map-menu {
            display: none;
            width: 200px;
        }

        #load-menu button,
        #main-menu button,
        #map-menu button {
            margin-bottom: 0.4rem;
            width: 100%;
        }

        #load-menu .button-quit-application,
        #main-menu .button-quit-application,
        #map-menu .button-quit-application {
            margin-bottom: 0;
        }

        /* Minimap */

        #minimap {
            bottom: 5px;
            right: 5px;
        }

        /* Objects - Admin */

        #objects-admin {
            display: none;
        }

        /* Options */
        #options {
            display: none;
        }

        /* Orders */

        #orders {
            bottom: 5px;
            left: 220px;
        }

        /* Orders - Admin */
        #orders-admin {
            display: none;
        }

        /* Players */

        #players {
            display: none;
            left: 700px;
            top: 60px;
        }

        /* Preview */

        #preview {
            display: none;
            left: 882px;
            top: 60px;
        }

        #preview .body {
            height: 128px;
            width: 128px;
        }

        /* Resources */

        #resources {
            display: flex;
            left: 5px;
            top: 100px;
            width: 300px;
        }

        #resources td {
            min-width: 50px;
        }

        #resources .green {
            color: green;
        }

        #resources .red {
            color: red;
        }

        /* Skills */

        #skills {
            bottom: 5px;
            left: 620px;
        }

        /* Statistics */

        #statistics {
            display: none;
        }

        /* Technologies */
        
        #technologies {
            display: none;
        }

        #technologies .placeholder button {
            margin: 5px;
        }
    </style>
</head>

<body>
    <!-- Container -->
    <div id="container">

        <!-- Configurations -->
        <div id="configurations" class="card panel">
            <div class="card-header">Configurations - none
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body placeholder">
                <!-- <button type="button" class="button" data-name="coal_mine">Coal Mine</button> -->
            </div>
        </div>

        <!-- Diplomacy -->
        <div id="diplomacy" class="card">
            <div class="card-header">Diplomacy</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr></tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button button-close">Close</button>
                </div>
            </div>
        </div>

        <!-- Game Menu -->
        <div id="game-menu" class="card ui layer-bottom">
            <div class="card-body">
                <button class="button button-diplomacy">Diplomacy</button>
                <button class="button button-layers">Layers</button>
                <button class="button button-main-menu">Menu</button>
                <button class="button button-objects">Objects</button>   
                <button class="button button-orders">Orders</button>
                <button class="button button-statistics">Statistics</button>
                <button class="button button-technologies">Technologies</button>
            </div>
        </div>

        <!-- Info -->
        <div id="info" class="card panel">
            <div class="card-header">Info
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body">
                <pre class="placeholder"></pre>
            </div>
        </div>

        <!-- Layers -->
        <div id="layers" class="card">
            <div class="card-header">Layers</div>

            <div class="card-body">
                <div class="container body">
                    <div class="placeholder">
                        <div class="row">
                            <div class="col-4">Air
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="None" id="Air_None" name="Air" checked="checked" />
                                    <label class="form-check-label" for="Air_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Air" data-data-layer-name="Pollution" id="Air_Pollution" name="Air" />
                                    <label class="form-check-label" for="Air_Pollution">Pollution</label>
                                </div>
                            </div>
                            <div class="col-4">Terrain
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="None" id="Terrain_None" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Height" id="Terrain_Height" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_Height">Height</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Navigation" id="Terrain_Navigation" name="Terrain" />
                                    <label class="form-check-label" for="Terrain_Navigation">Navigation</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Terrain" data-data-layer-name="Type" id="Terrain_Type" name="Terrain" checked="checked" />
                                    <label class="form-check-label" for="Terrain_Type">Type</label>
                                </div>
                            </div>
                            <div class="col-4">Water
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="None" id="Water_None" name="Water" />
                                    <label class="form-check-label" for="Water_None">None</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Height" id="Water_Height" name="Water" checked="checked" />
                                    <label class="form-check-label" for="Water_Height">Height</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Pollution" id="Water_Pollution" name="Water" />
                                    <label class="form-check-label" for="Water_Pollution">Pollution</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" data-layer-name="Water" data-data-layer-name="Type" id="Water_Type" name="Water" />
                                    <label class="form-check-label" for="Water_Type">Type</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="buttons">
                        <button class="button button-close">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Load Menu -->
        <div id="load-menu" class="card ui centered">
            <div class="card-header">Load</div>
            <div class="card-body">
                <button class="button-continue button">Continue</button>
                <div class="placeholder">
                    <button class="button" data-name="2017_10_12_12_51_41">2017_10_12_12_51_41</button>
                    <button class="button" data-name="2018_10_12_12_51_41">2018_10_12_12_51_41</button>
                    <button class="button" data-name="2019_10_12_12_51_41">2019_10_12_12_51_41</button>
                    <button class="button" data-name="2020_10_03_12_51_19">2020_10_03_12_51_19</button>
                    <button class="button" data-name="2020_11_10_13_21_33">2020_11_10_13_21_33</button>
                </div>
                <button class="button-quit-game button">Quit to menu</button>
                <button class="button-quit-application button">Quit to desktop</button>
            </div>
        </div>

        <!-- Log -->
        <div id="log" class="card ui layer-middle">
            <div class="card-body placeholder">
                <!-- <p class="info">13:22:24 Tank created</p> -->
            </div>
        </div>

        <!-- Main Menu -->
        <div id="main-menu" class="card ui centered">
            <div class="card-header">Menu</div>
            <div class="card-body">
                <button class="button button-continue">Continue</button>
                <button class="button button-new-game">New game</button>
                <button class="button button-save">Save</button>
                <button class="button button-load">Load</button>
                <button class="button button-options">Options</button>
                <button class="button button-quit-game">Quit to menu</button>
                <button class="button button-quit-application">Quit to desktop</button>
            </div>
        </div>

        <!-- Map Menu -->
        <div id="map-menu" class="card ui centered">
            <div class="card-header">Maps</div>
            <div class="card-body">
                <button class="button-continue button">Continue</button>
                <div class="placeholder">
                    <button class="button" data-name="tutorial #1">tutorial #1</button>
                    <button class="button" data-name="tutorial #2">tutorial #2</button>
                    <button class="button" data-name="level #1">level #1</button>
                    <button class="button" data-name="level #2">level #2</button>
                    <button class="button" data-name="level #3">level #3</button>
                </div>
                <button class="button-quit-game button">Quit to menu</button>
                <button class="button-quit-application button">Quit to desktop</button>
            </div>
        </div>

        <!-- Minimap-->
        <div id="minimap" class="card panel">
            <div class="card-header">Minimap
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body">
                <img src="texture_minimap" />
            </div>
        </div>

        <!-- Objects (admin) -->
        <div id="objects-admin" class="card">
            <div class="card-header">Objects</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th class="number" data-column="id">ID</th>
                            <th data-column="name">Name</th>
                            <th class="number" data-column="order_count">Order count</th>
                            <th data-column="current_order">Current order</th>
                        </tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button button-close">Close</button>
                </div>
            </div>
        </div>

        <!-- Options -->
        <div id="options" class="card">
            <div class="card-header">Options</div>
            <div class="card-body">
                <form>
                    <div class="form-group row">
                        <label for="input_mouse_sensivity_x" class="col-sm-4 col-form-label">Mouse sensivity X</label>
                        <div class="col-sm-8">
                            <input type="email" class="form-control" id="input_mouse_sensivity_x" name="input_mouse_sensivity_x" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="input_mouse_sensivity_y" class="col-sm-4 col-form-label">Mouse sensivity Y</label>
                        <div class="col-sm-8">
                            <input type="email" class="form-control" id="input_mouse_sensivity_y" name="input_mouse_sensivity_y" />
                        </div>
                    </div>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Fog of war type</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_fuzzy" value="fuzzy" />
                                    <label class="form-check-label" for="fog_of_war_type_fuzzy">fuzzy</label>
                                </div>

                                <div class="form-check disabled">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_solid" value="solid" />
                                    <label class="form-check-label" for="fog_of_war_type_solid">solid</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fog_of_war_type" id="fog_of_war_type_none" value="none" />
                                    <label class="form-check-label" for="fog_of_war_type_none">none</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Minimap</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_visible" value="visible" />
                                    <label class="form-check-label" for="ui_minimap_visible">visible</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_minimap_visible" id="ui_minimap_hidden" value="hidden" />
                                    <label class="form-check-label" for="ui_minimap_hidden">hidden</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-group">
                        <div class="row">
                            <legend class="col-form-label col-sm-4 pt-0">Preview</legend>
                            <div class="col-sm-8">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_visible" value="visible" />
                                    <label class="form-check-label" for="ui_preview_visible">visible</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ui_preview_visible" id="ui_preview_hidden" value="hidden" />
                                    <label class="form-check-label" for="ui_preview_hidden">hidden</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <div class="col-sm-12 buttons">
                        <button type="submit" class="button">Save</button>
                        <button class="button button-close">Close</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Orders -->
        <div id="orders" class="card panel">
            <div class="card-header">Orders - None
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body placeholder">
                <!-- <button type="button" class="button" data-name="Move">Move</button> -->
            </div>
        </div>

        <!-- Orders (admin) -->
        <div id="orders-admin" class="card">
            <div class="card-header">Orders</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th class="number" data-column="id">ID</th>
                            <th class="number" data-column="sender_id">Sender</th>
                            <th class="number" data-column="receiver_id">Receiver</th>
                            <th data-column="type">Type</th>
                        </tr>
                    </thead>
                    <tbody class="placeholder"></tbody>
                </table>

                <div class="buttons">
                    <button class="button button-close">Close</button>
                </div>
            </div>
        </div>

        <!-- Players -->
        <div id="players" class="card panel">
            <div class="card-header">Players
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body">
                <table class="table table-condensed no-header">
                    <tbody class="placeholder">
                        <tr data-id="1"><td class="id number">1</td><td class="color">green</td><td class="name">CPU 1</td></tr>
                        <tr data-id="2"><td class="id number">2</td><td class="color">yellow</td><td class="name">CPU 2</td></tr>
                        <tr data-id="3"><td class="id number">3</td><td class="color">red</td><td class="name">Human</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Preview -->
        <div id="preview" class="card panel">
            <div class="card-header">Preview
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body">
                <img src="preview_minimap" />
            </div>
        </div>

        <!-- Resources -->
        <div id="resources" class="card panel">
            <div class="card-header">Resources
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body">
                <table class="table table-condensed no-header">
                    <tbody class="placeholder">
                        <!-- <tr><td class="name">Coal</td><td class="current number">10</td><td class="max number">100</td><td class="per_second number green">2.0</td></tr> -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Skills -->
        <div id="skills" class="card panel">
            <div class="card-header">Skills - none
                <img class="button-collapse" src="icons/arrow-up-short.png" />
                <img class="button-expand" src="icons/arrow-down-short.png" />
            </div>

            <div class="card-body placeholder">
                <!-- <button type="button" class="button" data-name="repair">Repair</button> -->
            </div>
        </div>

        <!-- Statistics -->
        <div id="statistics" class="card">
            <div class="card-header">Statistics</div>
            <div class="card-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th data-column="name">Name</th>
                            <th class="number" data-column="value">Value</th>
                        </tr>
                    </thead>
                    <tbody class="placeholder">
                        <tr><td class="name">Mouse clicks</td><td class="value number">30</td></tr>
                        <tr><td class="name">Objects created</td><td class="value number">250</td></tr>
                        <tr><td class="name">Orders completed</td><td class="value number">1080</td></tr>
                        <tr><td class="name">Distance driven</td><td class="value number">1080.35</td></tr>
                    </tbody>
                </table>

                <div class="buttons">
                    <button class="button button-close">Close</button>
                </div>
            </div>
        </div>

        <!-- Technologies -->
        <div id="technologies" class="card">
            <div class="card-header">Technologies</div>
            <div class="card-body">
