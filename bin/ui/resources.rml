<rml>
	<head>
		<title>Demo</title>
		<link type="text/rcss" href="invader.rcss"/>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="ui.rcss"/>
	</head>
	<body id="resources" class="window">
		<div id="title_bar">
			<handle move_target="#document">
				<div id="icon"></div>
				<span id="title">Resources</span>
			</handle>
		</div>
		<div id="window">
			<div id="content">
				<p><span class="name">Metal</span>: <span class="value">50.2</span></p>
			</div>
		</div>
		<handle size_target="#document" style="position: absolute; width: 16dp; height: 16dp; bottom: 0px; right: 0px; cursor: resize;"></handle>
	</body>
</rml>
