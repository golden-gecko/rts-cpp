/*** Global ***/

body, div, p, pre, td {
	text-align: left;
}

body, div, p, pre {
	color: black;
}

div, p {
	display: block;

}

pre {
	white-space: pre-wrap;
}

.hidden {
	display: none;
}

/*** Content ***/

div#content {
	text-align: left;
}

/*** Table ***/

table {
	display: table;
}

thead, tbody, tfoot {
	display: table-row-group;
}

tr {
	display: table-row;
}

td {
	display: table-cell;
}

td.green {
	color: green;
}

td.red {
	color: red;
}

td.number {
	padding-right: 20dp;
	text-align: right;
}

td.text {
	padding-left: 20dp;
}

/*** Menu ***/

.menu {
	inset: 300dp 600dp;
	z-index: 100;
}

.menu .button {
	display: block;
	margin: 0 auto;
}

/*** Panel ***/

.panel {
	position: absolute;
}

/*** Popup ***/

.popup {
	inset: 5dp;
	z-index: 100;
}

/*** Configurations ***/

#configurations {
	bottom: 265dp;
	left: 550dp;
}

/*** Game Menu ***/

#game-menu {
	right: 5dp;
	top: 5dp;
}

/*** Info ***/

#info {
	bottom: 5dp;
	left: 310dp;
}

/*** Log ***/

#log {
	left: 5dp;
	top: 5dp;
}

#log .error {
	color: red;
}

#log .info {
	color: green;
}

/*** Minimap ***/

#minimap {
	bottom: 5dp;
	right: 5dp;
}

/*** Orders ***/

#orders {
	bottom: 150dp;
	left: 550dp;
}

/*** Players ***/

#players {
	right: 5dp;
	top: 100dp;
}

/*** Preview ***/

#preview {
	bottom: 5dp;
	left: 5dp;
}

/*** Resources ***/

#resources {
	left: 5dp;
	top: 130dp;
}

#resources table {
	width: 300dp;
}

#resources td {
	width: 100dp;
}

/*** Skills ***/

#skills {
	bottom: 5dp;
	left: 550dp;
}
