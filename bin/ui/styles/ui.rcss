/*** Global ***/

body, div, p, pre, td {
	text-align: left;
}

body, div, p, pre {
	color: black;
}

div, p {
	display: block;

}

pre {
	white-space: pre-wrap;
}

.hidden {
	display: none;
}

/*** Content ***/

div#content {
	text-align: left;
}

/*** Table ***/

table {
	display: table;
}

thead, tbody, tfoot {
	display: table-row-group;
}

tr {
	display: table-row;
}

td {
	display: table-cell;
	padding: 2dp;
}

td.green {
	color: green;
}

td.red {
	color: red;
}

td.number {
	padding-right: 20dp;
	text-align: right;
}

td.text {
	padding-left: 20dp;
}

/*** Menu ***/

.menu {
	inset: 300dp 600dp;
	z-index: 100;
}

.menu .button {
	display: block;
	margin: 0 auto;
}

/*** Panel ***/

.panel {
	position: absolute;
}

/*** Popup ***/

.popup {
	inset: 100dp;
	z-index: 100;
}

.popup .buttons {
	bottom: 0;
	display: block;
	position: absolute;
	text-align: center;
	width: 100%;
}

/*** Configurations ***/

#configurations {
	bottom: 265dp;
	left: 550dp;
}

/*** Console ***/

#console input.text {
	bottom: 5dp;
	left: 5dp;
	position: absolute;
}

/*** Game Menu ***/

#game-menu {
	right: 5dp;
	top: 5dp;
}

/*** Info ***/

#info {
	bottom: 5dp;
	left: 310dp;
}

/*** Log ***/

#log {
	left: 5dp;
	width: 400dp;
	top: 5dp;
}

#log .error {
	color: red;
}

#log .info {
	color: green;
}

/*** Minimap ***/

#minimap {
	bottom: 5dp;
	right: 5dp;
}

/*** Order Queue ***/

#order-queue {
	left: 5dp;
	top: 500dp;
}

#order-queue button {
	width: 30dp;
}

#order-queue td.button {
	text-align: center;
}

#order-queue table,
#order-queue tr,
#order-queue td {
	border: 0;
	vertical-align: middle;
}

#order-queue table {
	width: 300dp;
}

/*** Orders ***/

#orders {
	bottom: 150dp;
	left: 550dp;
}

/*** Players ***/

#players {
	right: 5dp;
	top: 100dp;
}

#players {
	width: 250dp;
}

/*** Preview ***/

#preview {
	bottom: 5dp;
	left: 5dp;
}

/*** Resources ***/

#resources {
	left: 5dp;
	top: 130dp;
}

#resources table {
	width: 300dp;
}

#resources td {
	width: 100dp;
}

#resources td.text {
	width: 200dp;
}

/*** Skills ***/

#skills {
	bottom: 5dp;
	left: 550dp;
}

/*** Unit Editor ***/

.unit-editor-preview,
.unit-editor-component-list {
	float: left;
	width: 40%;
}

.unit-editor-component-list-header {
	
}

.unit-editor-component-list-item {
	margin-left: 20px;
}
