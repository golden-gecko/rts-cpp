                                "consumption": 10.0,
                                "deposit_range": 100.0,
                                "need_deposit": true
                            }
                        }
                    },
                    "out": {
                        "items": {
                            "Coal": {
                                "production": 10.0
                            },
                            "Pollution": {
                                "production": 0.1
                            }
                        }
                    }
                }
            }
        },
        {
            "configuration": "small_storage",
            "resources": {
                "items": {
                    "Coal": {
                        "max": 100.0
                    },
                    "Pollution": {
                        "max": 1000000.0
                    }
                }
            }
        }
    ],
    "creatable": {
        "by_game": true,
        "by_player": true
    },
    "include": [
        "../objects/buildings/_building.json"
    ],
    "name": "Coal Mine",
    "orders": {
        "available": [
            "Destroy",
            "Stop",
            "Wait"
        ]
    }
