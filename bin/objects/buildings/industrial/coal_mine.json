{
    "components": [
        {
            "configuration": "mine_hull",
            "mesh": {
                "name": "mine.mesh",
                "scale": {
                    "x": 5.0,
                    "y": 5.0,
                    "z": 5.0
                }
            }
        },
        {
            "configuration": "slow_producer",
